{
  "id": "./",
  "name": "Ultimate Calculator",
  "short_name": "Calculator",
  "description": "Calculator, unit converter, graphs, and VAT, fuel and energy cost calculators in one fast app.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070a0f",
  "theme_color": "#0b0f14",
